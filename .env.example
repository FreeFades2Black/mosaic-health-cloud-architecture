# ==============================================================================
# MOSAIC HEALTHCARE: AZURE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate with your environment secrets
# ==============================================================================

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_PRIMARY_DOMAIN=example.onmicrosoft.com
AZURE_DIRECTORY_NAME="Default Directory"
AZURE_LICENSE="Microsoft Entra ID Free"

# Terraform / OpenTofu Environment Variables
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=your_client_secret_here
ARM_USE_AZUREAD=true
